{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Automatic SageMaker pipeline completion. No model jobs, tracking server or model image is created.",
  "Parameters": {
    "Namespace": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9][A-Za-z0-9-]{0,45}"
    },
    "CodeBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "DataBucket": {
      "Type": "String"
    },
    "TrackingUri": {
      "Type": "String",
      "Default": ""
    },
    "WatchFrom": {
      "Type": "String"
    },
    "S3Root": {
      "Type": "String"
    },
    "RegistryPrefix": {
      "Type": "String",
      "Default": ""
    },
    "KmsKey": {
      "Type": "String",
      "Default": ""
    },
    "PermissionsBoundaryArn": {
      "Type": "String",
      "Default": ""
    },
    "TrackingArtifactResources": {
      "Type": "CommaDelimitedList",
      "Default": ""
    },
    "DataPrefix": {
      "Type": "String"
    }
  },
  "Conditions": {
    "HasTracking": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "TrackingUri"
            },
            ""
          ]
        }
      ]
    },
    "HasKms": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "KmsKey"
            },
            ""
          ]
        }
      ]
    },
    "HasBoundary": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PermissionsBoundaryArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Namespace}-completion"
        },
        "RetentionInDays": 14
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "PermissionsBoundary": {
          "Fn::If": [
            "HasBoundary",
            {
              "Ref": "PermissionsBoundaryArn"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "complete-executions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sagemaker:DescribePipeline",
                    "sagemaker:ListPipelineExecutions",
                    "sagemaker:DescribePipelineExecution",
                    "sagemaker:ListPipelineExecutionSteps",
                    "sagemaker:ListPipelineParametersForExecution",
                    "sagemaker:DescribePipelineDefinitionForExecution"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:pipeline/${Namespace}-training"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:pipeline/${Namespace}-training/execution/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:pipeline/${Namespace}-inference"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:pipeline/${Namespace}-inference/execution/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sagemaker:DescribeProcessingJob",
                    "sagemaker:DescribeTrainingJob",
                    "sagemaker:DescribeTransformJob",
                    "sagemaker:DescribeHyperParameterTuningJob",
                    "sagemaker:ListTrainingJobsForHyperParameterTuningJob"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:processing-job/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:training-job/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:transform-job/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:hyper-parameter-tuning-job/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "sagemaker:DescribeModelPackage",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:model-package/${RegistryPrefix}*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}/${DataPrefix}/*"
                  }
                },
                {
                  "Fn::If": [
                    "HasTracking",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "sagemaker:CallMlflowAppApi",
                        "sagemaker-mlflow:CreateExperiment",
                        "sagemaker-mlflow:SearchExperiments",
                        "sagemaker-mlflow:GetExperiment",
                        "sagemaker-mlflow:GetExperimentByName",
                        "sagemaker-mlflow:CreateRun",
                        "sagemaker-mlflow:GetRun",
                        "sagemaker-mlflow:SearchRuns",
                        "sagemaker-mlflow:LogBatch",
                        "sagemaker-mlflow:LogInputs",
                        "sagemaker-mlflow:UpdateRun",
                        "sagemaker-mlflow:ListArtifacts"
                      ],
                      "Resource": {
                        "Ref": "TrackingUri"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "HasKms",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "kms:Decrypt",
                        "kms:Encrypt",
                        "kms:GenerateDataKey"
                      ],
                      "Resource": {
                        "Ref": "KmsKey"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "HasTracking",
                    {
                      "Effect": "Allow",
                      "Action": [
                        "s3:GetObject",
                        "s3:PutObject",
                        "s3:AbortMultipartUpload"
                      ],
                      "Resource": {
                        "Ref": "TrackingArtifactResources"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Namespace}-completion"
        },
        "Handler": "handler.handler",
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Timeout": 900,
        "MemorySize": 1024,
        "EphemeralStorage": {
          "Size": 1024
        },
        "ReservedConcurrentExecutions": 1,
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "PIPELINES": {
              "Fn::Sub": "{\"arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:pipeline/${Namespace}-training\":\"training\",\"arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:pipeline/${Namespace}-inference\":\"inference\"}"
            },
            "S3_ROOT": {
              "Ref": "S3Root"
            },
            "WATCH_FROM": {
              "Ref": "WatchFrom"
            },
            "KMS_KEY": {
              "Ref": "KmsKey"
            }
          }
        }
      }
    },
    "InvocationRetries": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "Function"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 2,
        "MaximumEventAgeInSeconds": 21600
      }
    },
    "TerminalEvents": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "EventPattern": {
          "source": [
            "aws.sagemaker"
          ],
          "detail-type": [
            "SageMaker Model Building Pipeline Execution Status Change"
          ],
          "detail": {
            "pipelineArn": [
              {
                "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:pipeline/${Namespace}-training"
              },
              {
                "Fn::Sub": "arn:${AWS::Partition}:sagemaker:${AWS::Region}:${AWS::AccountId}:pipeline/${Namespace}-inference"
              }
            ],
            "currentPipelineExecutionStatus": [
              "Succeeded",
              "Failed",
              "Stopped"
            ]
          }
        },
        "Targets": [
          {
            "Id": "completion",
            "Arn": {
              "Fn::GetAtt": [
                "Function",
                "Arn"
              ]
            }
          }
        ]
      }
    },
    "Reconcile": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "ScheduleExpression": "rate(5 minutes)",
        "Targets": [
          {
            "Id": "completion",
            "Arn": {
              "Fn::GetAtt": [
                "Function",
                "Arn"
              ]
            },
            "Input": "{\"reconcile\":true}"
          }
        ]
      }
    },
    "TerminalEventsPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Function"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "TerminalEvents",
            "Arn"
          ]
        }
      }
    },
    "ReconcilePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Function"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "Reconcile",
            "Arn"
          ]
        }
      }
    },
    "Errors": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Completion writes failed; Lambda retries and the scheduled reconciliation retry automatically. Inspect the completion function logs.",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Function"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "FunctionArn": {
      "Value": {
        "Fn::GetAtt": [
          "Function",
          "Arn"
        ]
      }
    },
    "RoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "Role",
          "Arn"
        ]
      }
    },
    "EventRule": {
      "Value": {
        "Ref": "TerminalEvents"
      }
    },
    "ReconciliationRule": {
      "Value": {
        "Ref": "Reconcile"
      }
    }
  }
}
