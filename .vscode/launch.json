{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug current model entrypoint",
      "type": "debugpy",
      "request": "launch",
      "module": "mlops_models.entrypoints.${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/mlops-models/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
