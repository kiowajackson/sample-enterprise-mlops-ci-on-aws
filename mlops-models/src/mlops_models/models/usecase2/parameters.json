{
  "task_type": "classification",
  "seed": 42,
  "num_cpus": 2,
  "time_limit_seconds": 60,
  "feature_selection": {
    "top_k": 50,
    "sample_rows": 1000,
    "n_estimators": 40
  },
  "primary_key": "customer_id",
  "target_key": "churned_flag",
  "timestamp": "feature_asof_dt",
  "framework": "autogluon",
  "threshold": 0.5,
  "example_input": "curated_fake.csv",
  "tuning": {
    "objective": {
      "name": "validation:log_loss",
      "direction": "Minimize"
    },
    "parameters": {
      "max_depth": {
        "type": "Integer",
        "min": 3,
        "max": 10
      }
    },
    "fixed": {},
    "max_jobs": 3,
    "max_parallel_jobs": 1,
    "max_seconds": 1800,
    "trial_seconds": 600
  },
  "autogluon": {
    "classification": {
      "n_estimators": 40,
      "max_depth": 4
    }
  }
}
